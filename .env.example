# Copy to .env.local and fill in what you need. Every integration without credentials simply stays off.

# --- Core ---
GENLIMITLESS_DATA_DIR=        # where the SQLite DB, accounts and files live (default: ./data)
SESSION_SECRET=               # signs login sessions; set a long random string
OS_BASE_URL=http://localhost:3100
TZ=America/Chicago

# --- GitHub (self-build pipeline: proposals become PRs) ---
GITHUB_REPO=your-github-user/your-repo
AUTO_MERGE=                   # leave unset: the owner approves merges
PR_MERGE=

# --- Mail (IMAP/SMTP) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
SMTP_HOST=
SMTP_PORT=

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple (iCloud calendar / iMessage bridge) ---
APPLE_ID=
APPLE_APP_PASSWORD=
OWNER_IMESSAGE_HANDLE=
IMESSAGE_MIRROR_DIR=

# --- Notion ---
NOTION_TOKEN=

# --- Voice (optional) ---
OPENAI_API_KEY=
WHISPER_BIN=
WHISPER_MODEL=
